---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/cv';
import { url } from '../lib/url';
---
<Base title={`Page not found · ${profile.name}`} noindex>
  <main id="main" class="notfound">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container" style="position:relative">
      <p class="sh-label label"><span class="sh-num">404</span>Not found</p>
      <h1>This page doesn’t exist.</h1>
      <p>The link may be broken, or the page may have moved.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={url()}>Back to home <Icon name="arrow-right" size={17} class="i-arrow" /></a>
        <a class="btn btn-secondary" href={`${url()}#work`}>Selected work</a>
      </div>
    </div>
  </main>
</Base>
