---
// One article. Markdown from src/content/writing/, highlighted with Shiki (light and dark themes).
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, formatDate, type Post } from '../../lib/writing';
import { url } from '../../lib/url';
import { profile } from '../../data/cv';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, description, published, updated, tags } = post.data;
const pageUrl = new URL(url(`writing/${post.id}/`), Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: title,
    description,
    datePublished: published.toISOString(),
    ...(updated ? { dateModified: updated.toISOString() } : {}),
    url: pageUrl,
    author: { '@type': 'Person', name: profile.name, url: new URL(url(), Astro.site).toString() },
    keywords: tags.join(', '),
  },
];
---
<Base title={`${title} · ${profile.name}`} description={description} type="article" jsonLd={jsonLd} publishedTime={published.toISOString()}>
  <main id="main">
    <div class="container">
      <header class="article-head">
        <a class="back" href={url('writing/')}><Icon name="arrow-left" size={15} /> Writing</a>
        <h1>{title}</h1>
        <p class="article-desc">{description}</p>
        <p class="article-meta label">
          <time datetime={published.toISOString()}>{formatDate(published)}</time>
          {updated && <span>Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></span>}
          {tags.map((t) => <span>#{t}</span>)}
        </p>
      </header>
      <article class="article-body">
        <div class="prose"><Content /></div>
        {(newer || older) && (
          <nav class="article-nav" aria-label="More articles">
            {older && <a href={url(`writing/${older.id}/`)}><span class="label">Older</span><strong>{older.data.title}</strong></a>}
            {newer && <a href={url(`writing/${newer.id}/`)}><span class="label">Newer</span><strong>{newer.data.title}</strong></a>}
          </nav>
        )}
      </article>
    </div>
  </main>
</Base>
