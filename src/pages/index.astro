---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Footer from '../components/Footer.astro';
import { profile, skills, featured, projects, experience, education } from '../data/cv';
import overview from '../assets/locklens-overview.png';
import incident from '../assets/locklens-incident.png';
---
<Base>
  <Header />
  <main id="main">
    <Hero />

    <!-- Technical skills -->
    <section class="section section-light" id="skills" aria-labelledby="skills-title">
      <div class="container">
        <SectionHeading id="skills-title" kicker="Technical skills" title="What I work with." lead="Grouped by engineering discipline." />
        <ul class="skills-grid">
          {skills.map((s, i) => (
            <li class="skill-card reveal" style={`--d:${(i % 3) * 70}ms`}>
              <div class="skill-top">
                <span class="icon-tile"><Icon name={s.icon} size={22} /></span>
                <span class="skill-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3>{s.title}</h3>
              <p class="skill-summary">{s.summary}</p>
              <ul class="chips" aria-label={`${s.title} technologies`}>
                {s.items.map((t) => <li>{t}</li>)}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Featured projects -->
    <section class="section section-tint" id="projects" aria-labelledby="projects-title">
      <div class="container">
        <SectionHeading id="projects-title" kicker="Featured projects" title="Things I have built." />

        <article class="feature reveal" aria-labelledby="feature-title">
          <div class="feature-copy">
            <p class="eyebrow">{featured.label}</p>
            <h3 id="feature-title" class="feature-name">{featured.name}</h3>
            <p class="feature-summary">{featured.summary}</p>
            <p class="feature-detail">{featured.detail}</p>
            <ul class="chips" aria-label="LockLens technologies">{featured.stack.map((t) => <li>{t}</li>)}</ul>
            <div class="feature-actions">
              <a class="btn btn-primary" href={featured.website} rel="noopener">Visit website <Icon name="arrow-up-right" size={18} /></a>
              <a class="btn btn-outline" href={featured.source} rel="noopener"><Icon name="github" size={18} /> Source code</a>
            </div>
          </div>
          <div class="feature-media">
            <figure class="shot shot-main">
              <Picture src={overview} formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 960, 1440]} sizes="(min-width: 1024px) 600px, 92vw" alt="LockLens overview dashboard with database health, throughput and latency charts" loading="lazy" />
            </figure>
            <figure class="shot shot-overlay">
              <Picture src={incident} formats={['avif', 'webp']} fallbackFormat="webp" widths={[480, 720]} sizes="(min-width: 1024px) 320px, 50vw" alt="LockLens incident page for a blocking chain, showing the root blocker and waiting sessions" loading="lazy" />
            </figure>
          </div>
        </article>

        <div class="project-grid">
          {projects.map((p, i) => (
            <article class="project-card reveal" style={`--d:${i * 80}ms`}>
              <div class="project-body">
                <p class="eyebrow">{p.label}</p>
                <h3>{p.name}</h3>
                <p>{p.summary}</p>
                {p.detail && <p>{p.detail}</p>}
                <ul class="chips chips-sm" aria-label={`${p.name} technologies`}>{p.stack.map((t) => <li>{t}</li>)}</ul>
              </div>
              {p.links && (
                <div class="project-links">
                  {p.links.map((l) => (
                    <a class={`btn ${l.kind === 'website' ? 'btn-primary' : 'btn-outline'} project-link`} href={l.href} rel="noopener">
                      {l.kind === 'source' && <Icon name="github" size={18} />}
                      {l.kind === 'download' && <Icon name="download" size={18} />}
                      {l.label}
                      {(l.kind === 'website' || l.kind === 'reference') && <Icon name="arrow-up-right" size={18} />}
                    </a>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section class="section section-light" id="experience" aria-labelledby="experience-title">
      <div class="container">
        <SectionHeading id="experience-title" kicker="Professional experience" title="Where I have worked." />
        <ol class="timeline">
          {experience.map((r) => (
            <li class:list={['timeline-item reveal', { current: r.end === 'Present' }]}>
              <p class="timeline-period"><time>{r.start}</time> – <time>{r.end}</time></p>
              <div class="timeline-card">
                <div class="timeline-head">
                  <div>
                    <h3>{r.company}{r.org && <span class="timeline-org"> · {r.org}</span>}</h3>
                    <p class="timeline-role">{r.title}</p>
                  </div>
                  <span class="focus-pill">{r.focus}</span>
                </div>
                <p class="timeline-summary">{r.summary}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Education -->
    <section class="section section-tint section-compact" id="education" aria-labelledby="education-title">
      <div class="container education">
        <SectionHeading id="education-title" kicker="Education" title="Education & certification." class="education-heading" />
        <ul class="education-list">
          {education.map((e, i) => (
            <li class="education-item reveal" style={`--d:${i * 70}ms`}>
              <span class="icon-tile"><Icon name={e.icon} size={22} /></span>
              <div>
                <p class="education-title">{e.title}</p>
                <p class="education-detail">{e.detail}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Contact -->
    <section class="section section-hero contact" id="contact" aria-labelledby="contact-title">
      <div class="container contact-inner">
        <div class="reveal">
          <p class="kicker kicker-on-hero">Contact</p>
          <h2 id="contact-title" class="contact-title">Let’s get in touch.</h2>
          <p class="contact-text">I’m happy to talk about backend systems, infrastructure, LockLens, KeyShift or ExtendPad. Email is the best way to reach me.</p>
        </div>
        <div class="contact-actions reveal" style="--d:80ms">
          <a class="btn btn-light btn-lg" href={`mailto:${profile.email}`}><Icon name="mail" size={20} /> {profile.email}</a>
          <div class="contact-links">
            <a class="round-link" href={profile.github} rel="me noopener" aria-label="GitHub"><Icon name="github" size={22} /></a>
            <a class="round-link" href={profile.linkedin} rel="me noopener" aria-label="LinkedIn"><Icon name="linkedin" size={22} /></a>
          </div>
        </div>
      </div>
      <Footer />
    </section>
  </main>

  <script>
    const items = document.querySelectorAll<HTMLElement>('.reveal');
    if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      items.forEach((el) => el.classList.add('in'));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.1 },
      );
      items.forEach((el) => io.observe(el));
    }
  </script>
</Base>
