---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Ambient from '../components/hero/Ambient.astro';
import HeroScene from '../components/hero/HeroScene.astro';
import CareerStrip from '../components/hero/CareerStrip.astro';
import BrowserGallery from '../components/BrowserGallery.astro';
import LockDemo from '../components/demos/LockDemo.astro';
import CacheDemo from '../components/demos/CacheDemo.astro';
import DeviceStage from '../components/demos/DeviceStage.astro';
import Expertise from '../components/Expertise.astro';
import ProjectLinks from '../components/ProjectLinks.astro';
import { profile, experience, education } from '../data/cv';
import { moreProjects, getProject } from '../data/projects';
import { getPosts, formatDate } from '../lib/writing';
import { url } from '../lib/url';

const locklens = getProject('locklens');
const keyshift = getProject('keyshift');
const extendpad = getProject('extendpad');
const posts = (await getPosts()).slice(0, 3);
const order = ['work', 'experience', 'expertise', 'about', 'education', ...(posts.length ? ['writing'] : []), 'contact'];
const num = (id: string) => String(order.indexOf(id) + 1).padStart(2, '0');
const focus = [
  { label: 'Backend engineering', tone: 'indigo' },
  { label: 'Distributed systems', tone: 'violet' },
  { label: 'Databases', tone: 'cyan' },
  { label: 'Infrastructure', tone: 'blue' },
  { label: 'Open-source engineering', tone: 'emerald' },
];

const home = new URL(url(), Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    url: home,
    mainEntity: {
      '@type': 'Person',
      name: profile.name,
      jobTitle: profile.role,
      url: home,
      email: `mailto:${profile.email}`,
      sameAs: [profile.github, profile.linkedin],
      worksFor: { '@type': 'Organization', name: 'Galaxy FinX' },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Science, Ho Chi Minh City' },
      knowsAbout: ['Backend engineering', 'Distributed systems', 'Databases', 'Cloud infrastructure', 'PostgreSQL', 'Redis', 'Go', 'Kubernetes'],
    },
  },
];
---
<Base home type="profile" jsonLd={jsonLd} lightbox zone="brand">
  <main id="main">
    <!-- Hero -->
    <section class="hero" aria-labelledby="hero-title" data-zone="brand">
      <Ambient particles beam />
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="hero-kicker"><span class="pulse-dot" aria-hidden="true"></span>{profile.role} <span class="hero-kicker-dim">· currently in core banking</span></p>
          <h1 id="hero-title" class="hero-name">
            <span class="hn hn-1">Nguyen</span>
            <span class="hn hn-2 grad-text is-live">Gia Huy</span>
          </h1>
          <ul class="hero-focus" aria-label="Focus areas">
            {focus.map((f) => <li class={`tone-${f.tone}`}><i aria-hidden="true"></i>{f.label}</li>)}
          </ul>
          <p class="hero-statement">{profile.statement}</p>
          <p class="hero-intro">{profile.intro}</p>
          <div class="hero-actions">
            <a class="btn btn-primary btn-lg" href="#work">Explore my work <Icon name="arrow-right" size={17} class="i-arrow" /></a>
            <a class="btn btn-secondary btn-lg" href={profile.github} rel="me noopener"><Icon name="github" size={17} /> GitHub</a>
            <a class="btn btn-quiet btn-lg" href={profile.linkedin} rel="me noopener"><Icon name="linkedin" size={16} /> LinkedIn</a>
          </div>
        </div>
        <div class="hero-visual">
          <HeroScene />
        </div>
      </div>
      <div class="container">
        <CareerStrip />
      </div>
    </section>

    <!-- Selected work -->
    <div id="work" class="work">
      <section class="section work-intro" aria-labelledby="work-title" data-zone="brand">
        <div class="container">
          <SectionHeader
            id="work-title"
            num={num('work')}
            label="Selected work"
            title="Projects I've built."
            lead="A few personal projects I've built in the open, from investigating PostgreSQL incidents to caching Redis reads and extending a Mac display."
          />
          <ol class="work-index stagger" aria-label="Projects on this page">
            {[locklens, keyshift, extendpad].map((p, i) => (
              <li class={`t-${p.slug}`}>
                <a href={`#${p.slug}`} class="lit">
                  <span class="wi-num label">{String(i + 1).padStart(2, '0')}</span>
                  <span class="wi-name grad-text">{p.name}</span>
                  <span class="wi-area label">{p.area}</span>
                  <Icon name="arrow-down" size={18} class="wi-arrow" />
                </a>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- LockLens: screenshots and a lock-contention walkthrough -->
      <section class="act t-locklens" id="locklens" aria-labelledby="locklens-title" data-zone="locklens">
        <div class="act-glow" aria-hidden="true"></div>
        <div class="container">
          <div class="grid-12 act-split">
            <div class="act-intro reveal">
              <p class="act-kicker label"><span class="act-num">01</span>{locklens.area}</p>
              <h3 id="locklens-title" class="act-name grad-text" style="view-transition-name: name-locklens">{locklens.name}</h3>
              <p class="act-tagline">{locklens.tagline}</p>
              <p class="act-text" set:html={locklens.problem} />
              <p class="act-text" set:html={locklens.approach} />
              <ul class="act-points">{locklens.highlights.slice(0, 3).map((h) => <li set:html={h} />)}</ul>
              <ProjectLinks links={locklens.links} name={locklens.name} />
              <p class="status"><span><span class="status-kind">{locklens.kind}.</span> {locklens.status}</span></p>
            </div>
            <div class="act-media reveal" style="--d:120ms">
              <BrowserGallery shots={locklens.shots!} id="ll-gallery" address="127.0.0.1:8080 · LockLens demo lab" tilt />
            </div>
          </div>
          <div class="reveal"><LockDemo /></div>
        </div>
      </section>

      <!-- KeyShift: simulation first, then the measured results -->
      <section class="act t-keyshift" id="keyshift" aria-labelledby="keyshift-title" data-zone="keyshift">
        <div class="act-glow" aria-hidden="true"></div>
        <div class="container">
          <div class="act-banner reveal">
            <div>
              <p class="act-kicker label"><span class="act-num">02</span>{keyshift.area}</p>
              <h3 id="keyshift-title" class="act-name grad-text" style="view-transition-name: name-keyshift">{keyshift.name}</h3>
              <p class="act-tagline">{keyshift.tagline}</p>
            </div>
            <ProjectLinks links={keyshift.links} name={keyshift.name} />
          </div>
          <div class="reveal"><CacheDemo /></div>
          <div class="grid-12 act-split act-split-low">
            <div class="act-intro reveal">
              <p class="act-text" set:html={keyshift.problem} />
              <p class="act-text" set:html={keyshift.approach} />
              <ul class="stack" aria-label="KeyShift technologies">{keyshift.stack.map((t) => <li>{t}</li>)}</ul>
              <p class="status"><span><span class="status-kind">{keyshift.kind}.</span> {keyshift.status}</span></p>
            </div>
            <div class="bench-card reveal lit" style="--d:100ms">
              <p class="bench-card-head"><span class="label">Measured</span><span class="demo-badge demo-badge-real">Benchmark suite</span></p>
              <div class="range">
                <p class="range-value"><span data-count="50">50</span>–<span data-count="86">86</span>%</p>
                <p class="range-label">fewer GETs reaching Redis in workloads with locality</p>
                <div class="range-track" aria-hidden="true"><span class="range-fill" style="--from:50%;--to:86%"></span></div>
                <div class="range-scale label" aria-hidden="true"><span>0%</span><span>50%</span><span>86%</span><span>100%</span></div>
              </div>
              <ul class="bench-mini">
                <li><span class="bm-value">≤ <span data-count="547">547</span></span><span class="bm-label">keys tracked by Redis per instance</span></li>
                <li><span class="bm-value">0</span><span class="bm-label">stale reads with connections killed and Redis restarted mid-run</span></li>
                <li><span class="bm-value">~<span data-count="0.3" data-decimals="1">0.3</span> µs</span><span class="bm-label">per local cache hit, rueidis driver</span></li>
              </ul>
              <p class="bench-note">{keyshift.metrics?.note} <a class="link" href={url('projects/keyshift/#benchmarks')}>Method and conditions</a></p>
            </div>
          </div>
        </div>
      </section>

      <!-- ExtendPad: device composition and pipeline -->
      <section class="act t-extendpad" id="extendpad" aria-labelledby="extendpad-title" data-zone="extendpad">
        <div class="act-glow" aria-hidden="true"></div>
        <div class="container">
          <div class="act-banner reveal">
            <div>
              <p class="act-kicker label"><span class="act-num">03</span>{extendpad.area}</p>
              <h3 id="extendpad-title" class="act-name grad-text" style="view-transition-name: name-extendpad">{extendpad.name}</h3>
              <p class="act-tagline">{extendpad.tagline}</p>
            </div>
            <ProjectLinks links={extendpad.links} name={extendpad.name} />
          </div>
          <div class="reveal"><DeviceStage /></div>
          <div class="grid-12 act-split act-split-low">
            <div class="act-intro reveal">
              <p class="act-text" set:html={extendpad.problem} />
              <p class="act-text" set:html={extendpad.approach} />
            </div>
            <div class="act-detail reveal" style="--d:100ms">
              <ul class="act-points">{extendpad.highlights.map((h) => <li set:html={h} />)}</ul>
              <ul class="stack" aria-label="ExtendPad technologies">{extendpad.stack.map((t) => <li>{t}</li>)}</ul>
              <p class="status"><span><span class="status-kind">{extendpad.kind}.</span> {extendpad.status}</span></p>
            </div>
          </div>
        </div>
      </section>

      <!-- Smaller projects -->
      <section class="more" aria-labelledby="more-title" data-zone="quiet">
        <div class="container">
          <h3 id="more-title" class="label">Also built</h3>
          <ul class="more-list">
            {moreProjects.map((p) => (
              <li class="more-item lit">
                <div class="more-name"><h4>{p.name}</h4><span class="label">{p.area}</span></div>
                <div class="more-text">
                  <p>{p.summary}</p>
                  <ul class="stack" aria-label={`${p.name} technologies`}>{p.stack.map((t) => <li>{t}</li>)}</ul>
                </div>
                <div class="more-link">
                  <a class="btn btn-secondary btn-sm" href={p.href} rel="noopener" aria-label={`${p.name} source code on GitHub`}><Icon name="github" size={16} /> Source</a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </div>

    <!-- Experience -->
    <section class="section t-career" id="experience" aria-labelledby="experience-title" data-zone="career">
      <div class="container">
        <SectionHeader
          id="experience-title"
          num={num('experience')}
          label="Experience"
          title="Where I've worked."
          lead="My experience across core banking, data pipelines, cloud infrastructure and blockchain services."
        />
        <ol class="tl">
          {experience.map((r) => (
            <li class:list={['tl-item reveal', { 'is-now': !r.endISO }]}>
              <div class="tl-when">
                <span class="mono"><time datetime={r.startISO}>{r.start}</time> – {r.endISO ? <time datetime={r.endISO}>{r.end}</time> : r.end}</span>
                {!r.endISO && <span class="tl-now">Current role</span>}
              </div>
              <span class="tl-dot" aria-hidden="true"></span>
              <div class="tl-body lit">
                <div class="tl-head">
                  <h3>{r.company}{r.org && <span class="tl-org"> · {r.org}</span>}</h3>
                  <p class="tl-title">{r.title}</p>
                </div>
                <p class="tl-domain">{r.domain}</p>
                <ul class="act-points">{r.points.map((pt) => <li>{pt}</li>)}</ul>
                {r.metrics && (
                  <ul class="tl-metrics" aria-label={`Highlights at ${r.company}`}>
                    {r.metrics.map((m) => (
                      <li>
                        <span class="tl-mv">{m.prefix}<span data-count={m.value}>{m.value}</span>{m.suffix}</span>
                        <span class="tl-ml">{m.label}</span>
                      </li>
                    ))}
                  </ul>
                )}
                <ul class="stack" aria-label={`Technologies at ${r.company}`}>{r.stack.map((t) => <li>{t}</li>)}</ul>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Expertise -->
    <section class="section" id="expertise" aria-labelledby="expertise-title" data-zone="brand">
      <div class="container">
        <SectionHeader
          id="expertise-title"
          num={num('expertise')}
          label="Expertise"
          title="What I work with."
          lead="The technologies I use and where I've applied them, at work and in personal projects."
        />
        <Expertise />
      </div>
    </section>

    <!-- About -->
    <section class="section" id="about" aria-labelledby="about-title" data-zone="quiet">
      <div class="container">
        <SectionHeader id="about-title" num={num('about')} label="About" title="A little about me." />
        <div class="grid-12 about-grid">
          <div class="about-copy reveal">
            <p class="about-first">
              I’m a software engineer focused on backend systems: the services and APIs, databases and infrastructure that keep
              applications running.
            </p>
            <p>
              I’ve worked on blockchain services at EsolLabs, a private Kubernetes cloud at VNPAY, and AWS data pipelines for
              au でんき at Vietlink. I’m now at Galaxy FinX, working on core banking for Vikki Digital Bank.
            </p>
            <p>
              Outside work, I enjoy building tools to explore problems that interest me. LockLens helps investigate PostgreSQL slowdowns
              and blocking; KeyShift selects Redis keys to cache locally; and ExtendPad turns an Android tablet into a second display for a Mac.
            </p>
          </div>
          <div class="about-side reveal" style="--d:100ms">
            <h3 class="label">How I approach projects</h3>
            <ol class="patterns">
              <li>
                <h4>Keep access limited</h4>
                <p>LockLens uses a read-only role and doesn’t change the databases it monitors. ExtendPad’s Mac app listens only on 127.0.0.1.</p>
              </li>
              <li>
                <h4>Put limits on resource use</h4>
                <p>When its store falls behind, LockLens drops the oldest batch and records the gap. ExtendPad keeps one frame slot before encoding, and KeyShift’s detector uses fixed memory.</p>
              </li>
              <li>
                <h4>Make decisions understandable</h4>
                <p>LockLens keeps the evidence behind each incident and distinguishes hypotheses from confirmed causes. KeyShift’s <code>Explain(key)</code> shows why a key is in its current state.</p>
              </li>
              <li>
                <h4>Be clear about limitations</h4>
                <p>I document what each project doesn’t do yet and include the machine and method behind benchmark results.</p>
              </li>
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- Education -->
    <section class="section section-compact" id="education" aria-labelledby="education-title" data-zone="quiet">
      <div class="container grid-12 split">
        <SectionHeader id="education-title" num={num('education')} label="Education" title="Education and certification." />
        <ul class="edu split-body stagger">
          {education.map((e) => (
            <li class="edu-row">
              <span class="label">{e.kind}</span>
              <span class="edu-title">{e.title}</span>
              <span class="edu-detail">{e.detail}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {posts.length > 0 && (
      <section class="section" id="writing" aria-labelledby="writing-title" data-zone="quiet">
        <div class="container">
          <SectionHeader id="writing-title" num={num('writing')} label="Writing" title="Technical writing." />
          <ul class="posts reveal">
            {posts.map((p) => (
              <li class="post-row">
                <a href={url(`writing/${p.id}/`)}>
                  <time class="label" datetime={p.data.published.toISOString()}>{formatDate(p.data.published)}</time>
                  <h3>{p.data.title}</h3>
                  <p>{p.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
          <p style="margin-top: 24px"><a class="link" href={url('writing/')}>All writing</a></p>
        </div>
      </section>
    )}

    <!-- Contact -->
    <section class="contact" id="contact" aria-labelledby="contact-title" data-zone="brand">
      <Ambient />
      <div class="container contact-inner reveal">
        <p class="sh-label label"><span class="sh-num">{num('contact')}</span>Contact</p>
        <h2 id="contact-title"><span class="grad-text is-live">Get in touch.</span></h2>
        <p class="contact-text">
          If you’d like to talk about backend systems, databases or any of my projects, feel free to email me.
        </p>
        <div class="contact-actions">
          <a class="btn btn-primary btn-lg contact-email" href={`mailto:${profile.email}`}><Icon name="mail" size={18} /> {profile.email}</a>
          <a class="btn btn-secondary btn-lg" href={profile.github} rel="me noopener"><Icon name="github" size={18} /> GitHub</a>
          <a class="btn btn-secondary btn-lg" href={profile.linkedin} rel="me noopener"><Icon name="linkedin" size={17} /> LinkedIn</a>
        </div>
      </div>
    </section>
  </main>
</Base>
