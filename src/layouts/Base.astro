---
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/home.css';
import '../styles/case.css';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import { profile } from '../data/cv';
import { url } from '../lib/url';
import { getPosts } from '../lib/writing';

interface Props {
  title?: string;
  description?: string;
  /** Open Graph type. */
  type?: 'website' | 'profile' | 'article';
  /** Extra JSON-LD objects for this page. */
  jsonLd?: Record<string, unknown>[];
  home?: boolean;
  noindex?: boolean;
  /** Include the screenshot lightbox. */
  lightbox?: boolean;
  publishedTime?: string;
  /** Theme class on <body> (t-brand, t-locklens, …). */
  theme?: string;
  /** Initial backdrop zone. */
  zone?: string;
}
const {
  title = `${profile.name}, ${profile.role}`,
  description = 'Nguyen Gia Huy is a software engineer working on backend systems, distributed systems, databases and cloud infrastructure, and the author of LockLens and KeyShift.',
  type = 'website',
  jsonLd = [],
  home = false,
  noindex = false,
  lightbox = false,
  publishedTime,
  theme = 't-brand',
  zone,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(url('og.png'), Astro.site).toString();
const hasRss = (await getPosts()).length > 0;
---
<!doctype html>
<html lang="en" data-zone={zone}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={profile.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f7fc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#060816" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    {hasRss && <link rel="alternate" type="application/rss+xml" title="Writing" href={url('writing/rss.xml')} />}
    <slot name="head" />

    <meta property="og:site_name" content={profile.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, ${profile.role}`} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    <!-- Before first paint: theme and motion. A saved choice wins, otherwise the system setting. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var t = null,
          m = null;
        try {
          t = localStorage.getItem('theme');
          m = localStorage.getItem('motion');
        } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        if (m !== 'reduced' && m !== 'full') m = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'reduced' : 'full';
        d.setAttribute('data-theme', t);
        d.setAttribute('data-motion', m);
      })();
    </script>
  </head>
  <body class={theme}>
    <div class="backdrop" aria-hidden="true"></div>
    <a class="skip" href="#main">Skip to content</a>
    <Header home={home} />
    <slot />
    <Footer />
    {lightbox && <Lightbox />}
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
