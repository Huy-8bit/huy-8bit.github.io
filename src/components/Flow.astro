---
// Flow lanes: each lane is one path through a system, read left to right
// (top to bottom when the figure is narrow).
import type { Flow } from '../data/flows';

interface Props {
  flow: Flow;
  caption?: string;
}
const { flow, caption } = Astro.props;
---
<figure class="flow-fig" aria-labelledby={`flow-${flow.id}-cap`}>
  <div class="flow ticks">
    {flow.lanes.map((lane) => (
      <div class:list={['lane', lane.tone && `is-${lane.tone}`]}>
        <p class="lane-label label">{lane.label}{lane.note && <small>{lane.note}</small>}</p>
        <ol class="lane-nodes">
          {lane.nodes.map((n, i) => (
            <>
              {i > 0 && <li class="arrow" aria-hidden="true" />}
              <li class:list={['node', { 'is-accent': n.accent, 'is-dashed': n.dashed }]}>
                <span class="node-title">{n.code ? <code>{n.title}</code> : n.title}</span>
                {n.sub && <span class="node-sub">{n.sub}</span>}
              </li>
            </>
          ))}
        </ol>
      </div>
    ))}
  </div>
  <figcaption id={`flow-${flow.id}-cap`} class="flow-cap">
    <span>{caption ?? flow.title}</span>
    {flow.legend?.accent && <span class="flow-key"><i class="k-accent" aria-hidden="true"></i>{flow.legend.accent}</span>}
    {flow.legend?.quiet && <span class="flow-key"><i aria-hidden="true" style="border-top-style:dashed"></i>{flow.legend.quiet}</span>}
  </figcaption>
</figure>
