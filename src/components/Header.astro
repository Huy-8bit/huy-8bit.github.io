---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, profile } from '../data/cv';

interface Props {
  /** Prefix for section links, e.g. the home URL on pages other than the home page. */
  linkBase?: string;
}
const { linkBase = '' } = Astro.props;
const home = import.meta.env.BASE_URL;
---
<header class="site-header" data-header>
  <div class="container header-inner">
    <a href={home} class="logo" aria-label={`${profile.name} — home`}>
      <Logo size={40} />
    </a>

    <nav class="nav" aria-label="Sections">
      <ul>
        {nav.map((l) => (
          <li><a href={`${linkBase}${l.href}`} data-nav={l.href.slice(1)}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <button type="button" class="menu-button" aria-expanded="false" aria-controls="mobile-menu" data-menu-button>
      <span class="sr-only">Menu</span>
      <Icon name="menu" size={22} class="i-open" />
      <Icon name="close" size={22} class="i-close" />
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden data-menu>
    <ul class="container">
      {nav.map((l) => (
        <li><a href={`${linkBase}${l.href}`}>{l.label}<Icon name="arrow-right" size={18} /></a></li>
      ))}
    </ul>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  const setOpen = (open: boolean) => {
    if (!button || !menu || !header) return;
    button.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    header.classList.toggle('menu-open', open);
  };
  button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      button.focus();
    }
  });
  window.matchMedia('(min-width: 860px)').addEventListener('change', (m) => m.matches && setOpen(false));

  // Highlight the section currently in view.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-nav]').forEach((a) => links.set(a.dataset.nav ?? '', a));
  const sections = [...links.keys()].map((id) => document.getElementById(id)).filter((s): s is HTMLElement => !!s);
  if (sections.length && 'IntersectionObserver' in window) {
    const visible = new Map<string, number>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) visible.set(e.target.id, e.isIntersecting ? e.intersectionRatio : 0);
        let best = '';
        let max = 0;
        for (const [id, r] of visible) if (r > max) [best, max] = [id, r];
        links.forEach((a, id) => (id === best ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
      },
      { rootMargin: '-35% 0px -45% 0px', threshold: [0, 0.01, 0.25, 0.5, 0.75, 1] },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
