---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, profile } from '../data/cv';
import { getPosts } from '../lib/writing';
import { url } from '../lib/url';

interface Props {
  /** True on the home page: section links stay on the page. */
  home?: boolean;
}
const { home = false } = Astro.props;
const prefix = home ? '' : url();
const hasWriting = (await getPosts()).length > 0;
const links = nav.map((l) => ({ ...l, href: `${prefix}${l.href}`, id: l.href.slice(1) }));
if (hasWriting) links.splice(links.length - 1, 0, { href: url('writing/'), label: 'Writing', id: '' });
---
<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href={url()} aria-label={`${profile.name}, home`}>
      <Logo size={26} class="brand-mark" />
      <span>{profile.name}</span>
    </a>

    <nav class="nav" aria-label="Main" data-nav>
      <ul>
        {links.map((l) => <li><a href={l.href} data-spy={home && l.id ? l.id : undefined}>{l.label}</a></li>)}
      </ul>
      <span class="nav-indicator" aria-hidden="true"></span>
    </nav>

    <div class="header-tools">
      <span class="header-sep" aria-hidden="true"></span>
      <a class="icon-btn header-social" href={profile.github} rel="me noopener" aria-label="GitHub profile"><Icon name="github" size={18} /></a>
      <a class="icon-btn header-social" href={profile.linkedin} rel="me noopener" aria-label="LinkedIn profile"><Icon name="linkedin" size={17} /></a>
      <button type="button" class="icon-btn motion-toggle" data-motion-toggle aria-pressed="false" aria-label="Pause animations">
        <Icon name="pause" size={16} class="i-pause" />
        <Icon name="play" size={16} class="i-play" />
      </button>
      <button type="button" class="icon-btn theme-toggle" data-theme-toggle aria-label="Switch theme">
        <Icon name="sun" size={18} class="i-sun" />
        <Icon name="moon" size={17} class="i-moon" />
      </button>
      <button type="button" class="icon-btn menu-btn" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu" data-menu-btn>
        <Icon name="menu" size={20} class="i-open" />
        <Icon name="close" size={20} class="i-close" />
      </button>
    </div>
  </div>
  <span class="progress" aria-hidden="true"></span>

  <div id="mobile-menu" class="mobile-menu" hidden data-menu>
    <nav class="container" aria-label="Main (mobile)">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}<Icon name="arrow-right" size={18} /></a></li>)}
      </ul>
      <div class="mobile-social">
        <a class="btn btn-secondary btn-sm" href={profile.github} rel="me noopener"><Icon name="github" size={16} /> GitHub</a>
        <a class="btn btn-secondary btn-sm" href={profile.linkedin} rel="me noopener"><Icon name="linkedin" size={15} /> LinkedIn</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>('[data-header]');
  const read = (k: string) => {
    try {
      return localStorage.getItem(k);
    } catch {
      return null;
    }
  };
  const write = (k: string, v: string) => {
    try {
      localStorage.setItem(k, v);
    } catch {
      /* storage unavailable: the choice lasts for this page only */
    }
  };

  // Theme: circular reveal from the toggle when motion is on and the browser supports view transitions.
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeLabel = () =>
    themeBtn?.setAttribute('aria-label', root.dataset.theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
  const setTheme = (t: string) => {
    root.dataset.theme = t;
    themeLabel();
  };
  themeLabel();
  themeBtn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    write('theme', next);
    const doc = document as Document & { startViewTransition?: (cb: () => void) => { finished: Promise<void> } };
    if (doc.startViewTransition && root.dataset.motion !== 'reduced') {
      const r = themeBtn.getBoundingClientRect();
      root.style.setProperty('--tx', `${r.left + r.width / 2}px`);
      root.style.setProperty('--ty', `${r.top + r.height / 2}px`);
      root.classList.add('theme-vt');
      doc.startViewTransition(() => setTheme(next)).finished.finally(() => root.classList.remove('theme-vt'));
    } else setTheme(next);
  });
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (!read('theme')) setTheme(e.matches ? 'dark' : 'light');
  });

  // Motion: pauses every continuous animation on the site (WCAG 2.2.2).
  const motionBtn = document.querySelector<HTMLButtonElement>('[data-motion-toggle]');
  const motionLabel = () => {
    const reduced = root.dataset.motion === 'reduced';
    motionBtn?.setAttribute('aria-pressed', String(reduced));
    motionBtn?.setAttribute('aria-label', reduced ? 'Play animations' : 'Pause animations');
  };
  motionLabel();
  motionBtn?.addEventListener('click', () => {
    root.dataset.motion = root.dataset.motion === 'reduced' ? 'full' : 'reduced';
    write('motion', root.dataset.motion);
    motionLabel();
    document.dispatchEvent(new CustomEvent('motionchange'));
  });

  // Mobile menu.
  const button = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const setOpen = (open: boolean) => {
    if (!button || !menu || !header) return;
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
    menu.hidden = !open;
    header.classList.toggle('menu-open', open);
  };
  button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      button.focus();
    }
  });
  window.matchMedia('(min-width: 961px)').addEventListener('change', (m) => m.matches && setOpen(false));

  // Active section: aria-current plus a sliding indicator under the link.
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const indicator = nav?.querySelector<HTMLElement>('.nav-indicator');
  const spy = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-spy]').forEach((a) => spy.set(a.dataset.spy!, a));
  const move = (a: HTMLAnchorElement | null) => {
    if (!indicator || !nav) return;
    if (!a) return indicator.style.setProperty('--o', '0');
    const n = nav.getBoundingClientRect();
    const r = a.getBoundingClientRect();
    indicator.style.setProperty('--x', `${r.left - n.left + 12}px`);
    indicator.style.setProperty('--w', `${r.width - 24}px`);
    indicator.style.setProperty('--o', '1');
  };
  const sections = [...spy.keys()].map((id) => document.getElementById(id)).filter((s): s is HTMLElement => !!s);
  if (sections.length && 'IntersectionObserver' in window) {
    let current: HTMLAnchorElement | null = null;
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          current = spy.get(e.target.id) ?? null;
          spy.forEach((a) => (a === current ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
          move(current);
        }
      },
      { rootMargin: '-40% 0px -55% 0px' },
    );
    sections.forEach((s) => io.observe(s));
    window.addEventListener('resize', () => move(current), { passive: true });
    // Leaving the tracked sections (back to the hero) hides the indicator.
    const hero = document.querySelector('.hero');
    if (hero)
      new IntersectionObserver((e) => {
        if (e[0]?.isIntersecting && e[0].intersectionRatio > 0.5) {
          current = null;
          spy.forEach((a) => a.removeAttribute('aria-current'));
          move(null);
        }
      }, { threshold: [0.5, 0.6] }).observe(hero);
  }
</script>
