---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { profile } from '../data/cv';
// Fictional 3D character. To swap it, replace this file with another transparent PNG
// (upper body, cropped flat at the bottom edge); the layout adapts to its aspect ratio.
import character from '../assets/hero-character.png';

const socials = [
  { href: profile.github, label: 'GitHub', icon: 'github' as const, rel: 'me noopener' },
  { href: profile.linkedin, label: 'LinkedIn', icon: 'linkedin' as const, rel: 'me noopener' },
  { href: `mailto:${profile.email}`, label: `Email ${profile.email}`, icon: 'mail' as const, rel: undefined },
];
---
<section class="hero" aria-labelledby="hero-name" data-hero>
  <div class="hero-stage">
    <div class="hero-identity">
      <h1 id="hero-name" class="hero-name enter" style="--enter:0">
        <span>Nguyen</span>
        <span>Gia Huy.</span>
      </h1>
      <span class="hero-rule enter" style="--enter:1" aria-hidden="true"></span>
      <ul class="hero-socials enter" style="--enter:2" aria-label="Profiles">
        {socials.map((s) => (
          <li>
            <a href={s.href} rel={s.rel} aria-label={s.label} title={s.label}>
              <Icon name={s.icon} size={24} />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="hero-figure" data-figure aria-hidden="true">
      <div class="hero-figure-float">
        <Picture
          src={character}
          formats={['avif', 'webp']} fallbackFormat="webp"
          widths={[420, 740]}
          sizes="(min-width: 1024px) 55vw, 90vw"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>

    <div class="hero-intro">
      <p class="hero-kicker enter" style="--enter:1">Introducing</p>
      <h2 class="hero-headline enter" style="--enter:2">
        {profile.headline[0]}<br />{profile.headline[1]}
      </h2>
      <p class="hero-text enter" style="--enter:3">{profile.intro}</p>
      <a href="#projects" class="btn btn-light hero-cta enter" style="--enter:4">
        Explore my work <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </div>
</section>

<script>
  // Gentle pointer parallax and scroll drift for the character (skipped for reduced motion).
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const figure = document.querySelector<HTMLElement>('[data-figure]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (hero && figure && !reduce.matches) {
    let px = 0;
    let py = 0;
    let tx = 0;
    let ty = 0;
    let raf = 0;
    const tick = () => {
      px += (tx - px) * 0.08;
      py += (ty - py) * 0.08;
      const drift = Math.min(window.scrollY, hero.offsetHeight) * 0.12;
      figure.style.setProperty('--px', `${px.toFixed(2)}px`);
      figure.style.setProperty('--py', `${(py + drift).toFixed(2)}px`);
      raf = Math.abs(tx - px) > 0.05 || Math.abs(ty - py) > 0.05 ? requestAnimationFrame(tick) : 0;
    };
    const kick = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };
    hero.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const r = hero.getBoundingClientRect();
      tx = ((e.clientX - r.left) / r.width - 0.5) * 14;
      ty = ((e.clientY - r.top) / r.height - 0.5) * 8;
      kick();
    });
    hero.addEventListener('pointerleave', () => {
      tx = 0;
      ty = 0;
      kick();
    });
    window.addEventListener('scroll', kick, { passive: true });
  }
</script>
